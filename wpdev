case "${1:-help}" in
    up) cmd_up ;;
    down) cmd_down ;;
    restart) cmd_restart ;;
    status) cmd_status ;;
    logs) cmd_logs "$2" ;;
    shell) cmd_shell "$2" ;;
    db) cmd_db "$2" ;;
    pma) cmd_pma "$2" ;;
    reload-nginx) cmd_reload_nginx ;;
    backup) cmd_backup ;;
    install-mkcert) cmd_install_mkcert ;;
    clean) cmd_clean ;;
    clean-all) cmd_clean_all ;;
    add) cmd_add ;;
    remove) cmd_remove "$2" ;;
    list) cmd_list ;;
    hosts) cmd_hosts ;;
    creds) cmd_creds "$2" ;;
    wp) shift; cmd_wp "$@" ;;
    help|-h|--help) show_help ;;
    *)
        print_warning "Unknown command: $1"
        echo ""
        show_help
        exit 1
        ;;
esac
